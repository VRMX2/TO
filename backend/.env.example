# CyberGameGT Backend — copy to .env and customize (never commit .env)

APP_NAME=CyberGameGT API
DEBUG=false

# API key required on all routes except /health and /ready (leave empty for local dev)
API_KEY=change-me-to-a-long-random-secret

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Trusted hosts (production)
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]

# WebSocket allowed browser origins
WS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Groq API key (server-side only — https://console.groq.com)
GROQ_API_KEY=

# Limits
MAX_MATRIX_SIZE=12
AI_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS=50
