# CyberGameGT Web — copy to .env.local for local development

# Must match backend API_KEY when auth is enabled
VITE_API_KEY=

# Optional: override WebSocket URL (default: same host /ws/threats)
# VITE_WS_URL=ws://localhost:5173/ws/threats

# Vite dev proxy target (docker compose sets this automatically)
# VITE_API_PROXY_TARGET=http://localhost:8000
